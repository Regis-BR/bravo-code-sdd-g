# ============================================================================
# bravo-code-sdd-g — .gitignore
# ============================================================================

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/settings.json
.vscode/launch.json
.idea/
*.iml

# ---------- Python (scripts auxiliares, validators, kb-mcp) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------- Node.js (kb-mcp em TypeScript, MkDocs build) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/
.yarn/
.yarn-integrity
package-lock.json.bak

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/

# ---------- Claude Code runtime ----------
.claude/dev/progress/*.md
!.claude/dev/progress/.gitkeep
.claude/dev/logs/*.md
!.claude/dev/logs/.gitkeep
.claude/.cache/
.claude/.tmp/
.claude/auto-memory.json
.claude/sessions/

# ---------- KB build artifacts (MkDocs - Onda 3) ----------
site/
docs/.cache/
docs/_build/

# ---------- Secrets / credentials (NUNCA commitar) ----------
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
.gh-token
.anthropic-key

# ---------- GitHub Actions local testing (act) ----------
.actrc
event.json

# ---------- MCP server (Onda 4) ----------
kb-mcp/dist/
kb-mcp/.env*
kb-mcp/coverage/

# ---------- Devcontainer (Onda 4) ----------
.devcontainer/.cache/

# ---------- Logs / temp ----------
*.log
logs/
tmp/
temp/
.tmp/

# ---------- DB / data files ----------
*.db
*.sqlite
*.sqlite3

# ---------- Backup files ----------
*.bak
*.backup
*.orig

# ---------- Local overrides (não versionar config local do dev) ----------
local-config.yaml
override.yaml
*.local.json

# ---------- Allowlist (forçar tracking de arquivos importantes) ----------
!.gitkeep
!.github/
!.claude/
!docs/
